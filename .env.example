# AgriNex Environment Variables
# Copy this file to .env and fill in real values

# App
VITE_APP_NAME=AgriNex
VITE_APP_ENV=development

# Weather API (e.g., OpenWeatherMap)
# Sign up at https://openweathermap.org/api
VITE_WEATHER_API_KEY=your_weather_api_key_here
VITE_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# IoT Backend
# Replace with your real backend URL when deployed
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: Map / Location Services
VITE_MAPS_API_KEY=your_maps_api_key_here
